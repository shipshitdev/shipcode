{
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@google/design.md": "0.2.0",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.8",
    "clawpatch": "0.5.0",
    "turbo": "2.9.16",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "name": "@shipcode/monorepo",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:skills": "bun scripts/build-skill-defaults.ts",
    "build:web": "turbo run build --filter=@shipcode/web",
    "clean": "turbo run clean",
    "clawpatch:init": "clawpatch init --no-input",
    "clawpatch:map": "clawpatch map",
    "clawpatch:report": "clawpatch report",
    "clawpatch:review": "clawpatch review",
    "clawpatch:review:quick": "clawpatch review --limit 3 --jobs 3",
    "clawpatch:status": "clawpatch status",
    "coverage": "turbo run build --filter='./packages/*' && bun run coverage:sharded && bun run coverage:summary",
    "coverage:legacy": "turbo run coverage && node scripts/coverage-summary.mjs",
    "coverage:sharded": "node scripts/run-coverage-shards.mjs",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "deploy:web": "bun run sync:docs && vercel deploy --prod --yes",
    "deps:update": "bunx npm-check-updates -u --deep --cooldown 3h && bun install",
    "deadcode": "bunx knip --production --include files,exports,dependencies,unlisted,unresolved --no-progress",
    "dev": "turbo run dev --filter=@shipcode/desktop",
    "dev:all": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@shipcode/desktop",
    "dev:docs": "turbo run dev --filter=@shipcode/docs",
    "dev:web": "turbo run dev --filter=@shipcode/web",
    "e2e": "turbo run e2e --filter=@shipcode/e2e",
    "e2e:ci": "turbo run e2e:ci --filter=@shipcode/e2e",
    "e2e:smoke": "turbo run e2e:smoke --filter=@shipcode/e2e",
    "format:check": "bun run lint",
    "hooks:setup": "sh scripts/setup-git-hooks.sh",
    "lint": "bunx biome check . --assist-enabled=false --files-ignore-unknown=true",
    "lint:design": "bunx design.md lint DESIGN.md",
    "lint:packages": "turbo run lint",
    "lint:repo": "bun run lint",
    "lint:fix": "bunx biome check --write .",
    "lint:staged": "sh scripts/lint-staged-biome.sh",
    "postinstall": "sh scripts/fix-node-pty-permissions.sh && sh scripts/setup-git-hooks.sh && sh scripts/setup-skills.sh",
    "skills:sync": "sh scripts/setup-skills.sh --sync",
    "sync:docs": "sh scripts/sync-docs-to-web.sh",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --maxWorkers=2",
    "typecheck": "turbo run typecheck",
    "verify:affected": "bun scripts/verify-affected-workspaces.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "patchedDependencies": {
    "nextra@4.6.1": "patches/nextra@4.6.1.patch",
    "nextra-theme-docs@4.6.1": "patches/nextra-theme-docs@4.6.1.patch"
  }
}
