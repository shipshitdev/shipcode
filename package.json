{
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.4",
    "@biomejs/biome": "2.4.12",
    "@types/node": "25.6.0",
    "esbuild": "0.28.0",
    "sass": "^1.99.0",
    "turbo": "2.9.6",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "name": "@shipcode/monorepo",
  "packageManager": "bun@1.3.12",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:skills": "bun scripts/build-skill-defaults.ts",
    "build:web": "turbo run build --filter=@shipcode/web",
    "clean": "turbo run clean",
    "coverage": "turbo run coverage && node scripts/coverage-summary.mjs",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "deploy:web": "bun run sync:docs && vercel deploy --cwd apps/web --prod --yes",
    "deps:update": "bunx npm-check-updates -u --deep && bun install",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@shipcode/desktop",
    "dev:docs": "turbo run dev --filter=@shipcode/docs",
    "dev:web": "turbo run dev --filter=@shipcode/web",
    "format:check": "bunx biome check . --linter-enabled=false --assist-enabled=false --files-ignore-unknown=true",
    "hooks:setup": "sh scripts/setup-git-hooks.sh",
    "lint": "turbo run lint",
    "lint:repo": "bunx biome check . --formatter-enabled=false --assist-enabled=false --files-ignore-unknown=true",
    "lint:fix": "bunx biome check --write .",
    "lint:staged": "sh scripts/lint-staged-biome.sh",
    "postinstall": "sh scripts/fix-node-pty-permissions.sh",
    "sync:docs": "sh scripts/sync-docs-to-web.sh",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "nextra@4.6.1": "patches/nextra@4.6.1.patch"
  }
}
